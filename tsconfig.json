{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": [
      "vitest/globals",
      "node"
    ],
    "paths": {
      "@app/common": [
        "./libs/common/src/index.js"
      ],
      "@app/common/*": [
        "./libs/common/src/*"
      ],
      "@app/model": [
        "./libs/model/src/index.js"
      ],
      "@app/model/*": [
        "./libs/model/src/*"
      ],
      "@app/prisma": [
        "./libs/model/src/generated/prisma/client.js"
      ],
      "@app/prisma/*": [
        "./libs/model/src/generated/prisma/*"
      ],
      "@app/rbac": [
        "./libs/rbac/src/index.js"
      ],
      "@app/rbac/*": [
        "./libs/rbac/src/*"
      ]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/identity-access/tsconfig.app.json"
    },
    {
      "path": "./apps/support-cases/tsconfig.app.json"
    }
  ]
}